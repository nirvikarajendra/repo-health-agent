{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/hooks/**)"
    ]
  },  
    "hooks": {
      "PostToolUse": [
        {
          "matcher": "Edit|Write",
          "hooks": [
            {
              "type": "command",
              "command": "uv run --quiet python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/format_python.py\""
            }
          ]
        }
      ]
    }
  }
  